# Source evidence is hashed byte-for-byte; checkout must never rewrite it.
data/kr/v2/source/** -text
# Content-addressed SVG assets and generated bundles must retain blob bytes
# on Windows as well as Linux; their cache versions are SHA-256 of these bytes.
*.svg text eol=lf
js/app.bundle.js text eol=lf
js/korean-service-resolver.js text eol=lf
js/line-workspace-data.js text eol=lf
