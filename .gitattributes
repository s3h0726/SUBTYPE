# Generated Korean text must be identical on Windows and Linux.
data/kr/v2/** text eol=lf
# Source evidence is hashed byte-for-byte; checkout must never rewrite it.
data/kr/v2/source/** -text
data/kr/v2/generated/*.csv text eol=lf
# Content-addressed SVG assets and generated bundles must retain blob bytes
# on Windows as well as Linux; their cache versions are SHA-256 of these bytes.
*.svg text eol=lf
js/app.bundle.js text eol=lf
js/korean-service-resolver.js text eol=lf
js/line-workspace-data.js text eol=lf

data/kr/preview/** text eol=lf

js/japan-lite-index.js text eol=lf

# Taiwan source snapshots and official marks retain their provenance hashes.
data/tw/** text eol=lf
data/tw/source/** -text
assets/operators/tw-thsr.svg -text -whitespace
reports/taiwan/*.json text eol=lf
